// Prisma schema — Travel Agency Sales Tracker (Phase 1)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  EMPLOYEE
}

enum PaymentStatus {
  PAID
  PARTIAL
  DUE
}

enum SaleStatus {
  ISSUED
  CANCELLED
  REFUNDED
  VOID
}

enum EntrySource {
  MANUAL
  DOCUMENT_UPLOAD
}

enum CabinClass {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
  FIRST
}

enum TripType {
  ONE_WAY
  ROUND_TRIP
}

enum AssetStatus {
  IN_USE
  SPARE
  UNDER_REPAIR
  RETIRED
}

enum ExpenseCategory {
  SALARY
  RENT
  UTILITIES
  MARKETING
  SUPPLIES
  OTHER
}

// What kind of service a Sale represents. Agents sell more than just air
// tickets — this drives which fields the sale form/report show, per
// requirements section 4 (the same Sale record backs every service type,
// not a separate table per type).
enum ServiceType {
  AIR_TICKET
  HOTEL
  VISA
  TOUR_PACKAGE
  INSURANCE
  OTHER
}

// One agency. Every core table below carries organizationId directly
// (not just derived through relations) so the system can be sold to
// multiple agencies later without a schema redesign, per requirements
// section 2.2.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  branches Branch[]
  users    User[]
  sales    Sale[]
  assets   Asset[]
  expenses Expense[]
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  location       String?
  // Archived rather than deleted — sales and employee history reference a
  // branch, so it's never hard-deleted (same soft-state pattern as Sale).
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  sales        Sale[]
  assets       Asset[]
  expenses     Expense[]

  @@index([organizationId])
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  // Nullable: owners/admins are org-wide and not tied to a branch.
  // Employees must have a branchId (enforced in application code).
  branchId       String?
  name           String
  email          String   @unique
  passwordHash   String
  role           Role
  // Deactivated accounts can't log in but keep their sale history intact —
  // same reasoning as Branch.active.
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id])

  salesSold      Sale[] @relation("SaleEmployee")
  salesCreated   Sale[] @relation("SaleCreatedBy")
  salesUpdated   Sale[] @relation("SaleUpdatedBy")

  assetsAssigned Asset[] @relation("AssetAssignedTo")
  assetsCreated  Asset[] @relation("AssetCreatedBy")

  expensesLinked Expense[] @relation("ExpenseEmployee")
  expensesCreated Expense[] @relation("ExpenseCreatedBy")

  @@index([organizationId])
  @@index([branchId])
}

model Sale {
  id             String @id @default(cuid())
  // Denormalized alongside branch/employee for defense-in-depth scoping
  // and simple filtering, per requirements section 2.2.
  organizationId String
  branchId       String
  employeeId     String

  // What's being sold on this record. Defaults to AIR_TICKET since that's
  // the primary business (requirements section 1); the fields below that
  // only make sense for a flight are optional so other service types can
  // leave them null instead of forking into a separate table per type.
  serviceType ServiceType @default(AIR_TICKET)

  passengerName String
  pnr           String?
  airline       String?
  origin        String?
  destination   String?
  // Doubles as the generic "when does this service happen" date across
  // every service type (check-in, visa needed-by, tour departure, coverage
  // start), relabeled per type in the UI — not just an air-ticket field.
  travelDate DateTime
  // Round-trip sales carry a return leg; one-way leaves this null. Also
  // reused (independent of tripType) as an optional end date for services
  // that have one — hotel check-out, tour return, insurance coverage end.
  tripType   TripType   @default(ONE_WAY)
  returnDate DateTime?
  cabinClass CabinClass @default(ECONOMY)
  // Tickets/units covered by this single sale record — passengerName may
  // list several names (e.g. a family), but reports need a count to tally
  // "tickets sold" accurately.
  paxCount      Int        @default(1)
  // Consolidator/GDS/vendor the service was bought through — distinct from
  // costPrice, useful for supplier-negotiation reporting (requirements 6.2).
  supplier      String?
  // Structured, per-service-type fields for everything that doesn't fit a
  // shared column (hotel name/room, visa destination/type, package name,
  // insurance policy type, ...) — schema for each serviceType lives in
  // src/lib/service-fields.ts rather than as dedicated columns, so adding
  // or adjusting a service's fields doesn't require a migration. Null for
  // AIR_TICKET, which uses the dedicated columns above instead.
  serviceAttributes Json?

  salePrice Decimal @db.Decimal(12, 2)
  costPrice Decimal @db.Decimal(12, 2)

  paymentStatus PaymentStatus @default(DUE)
  // Amount actually collected from the customer so far — paymentStatus alone
  // doesn't say how much of a PARTIAL sale is still outstanding.
  amountPaid    Decimal       @default(0) @db.Decimal(12, 2)

  customerPhone String?
  customerEmail String?

  saleDate DateTime    @default(now())
  // Soft status changes only — sales are never hard-deleted, to
  // preserve audit history (requirements section 7).
  status   SaleStatus  @default(ISSUED)
  source   EntrySource @default(MANUAL)
  notes    String?

  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id])
  employee     User         @relation("SaleEmployee", fields: [employeeId], references: [id])
  createdBy    User         @relation("SaleCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?        @relation("SaleUpdatedBy", fields: [updatedById], references: [id])

  @@index([organizationId])
  @@index([branchId])
  @@index([employeeId])
  @@index([saleDate])
  @@index([status])
  @@index([serviceType])
}

// Fixed asset / equipment inventory (PCs, printers, scanners, mobiles,
// furniture, ...) tracked per branch, alongside sales in the same app.
model Asset {
  id             String @id @default(cuid())
  organizationId String
  branchId       String

  name     String
  category String
  // Set only for individually-tracked items (e.g. a specific laptop).
  // Left null for bulk/untracked items, where `quantity` may be > 1.
  serialNumber String?
  quantity     Int     @default(1)

  status       AssetStatus @default(IN_USE)
  // Employee currently holding custody of this item, if applicable.
  assignedToId String?

  purchaseDate  DateTime?
  purchasePrice Decimal?  @db.Decimal(12, 2)
  notes         String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id])
  assignedTo   User?        @relation("AssetAssignedTo", fields: [assignedToId], references: [id])
  createdBy    User         @relation("AssetCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([branchId])
  @@index([status])
}

// Operating costs (salaries, rent, utilities, ...) — the other half of the
// P&L that Sale alone can't show. branchId is nullable for org-wide costs
// (e.g. marketing); employeeId is set for salary/bonus/advance entries tied
// to a specific person, which is what powers the compensation view on that
// employee's detail page.
model Expense {
  id             String @id @default(cuid())
  organizationId String
  branchId       String?
  employeeId     String?

  category    ExpenseCategory
  description String
  amount      Decimal  @db.Decimal(12, 2)
  expenseDate DateTime @default(now())
  // Voided rather than deleted — financial records are never hard-deleted,
  // same reasoning as Sale's soft status (requirements section 7).
  voided      Boolean  @default(false)
  notes       String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id])
  employee     User?        @relation("ExpenseEmployee", fields: [employeeId], references: [id])
  createdBy    User         @relation("ExpenseCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([branchId])
  @@index([employeeId])
  @@index([expenseDate])
  @@index([category])
}
